# MongoDB Connection URI (defaults to local MongoDB or auto in-memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_finance_controller

# Server Port
PORT=5000

# AI Provider API Keys (Supports Gemini / AI_API_KEY)
# If left blank, the application will use the built-in deterministic financial intelligence engine
GEMINI_API_KEY=
AI_API_KEY=

# Environment
NODE_ENV=development
